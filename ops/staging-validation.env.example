# Copy to ops/staging-validation.env. Do not commit the populated file.
# For a local Compose run, use http://127.0.0.1:8000 and http://127.0.0.1:8080.
# For remote staging, both origins must be bare HTTPS origins.
EAROS_VALIDATION_MODE=staging
EAROS_PUBLIC_API_ORIGIN=https://api-staging.replace-with-your-domain.example
EAROS_STAGING_WEB_ORIGIN=https://staging.replace-with-your-domain.example

# The following values must be created in a non-production tenant by the release owner.
# Use a least-privileged recruiter or administrator session that belongs only to the allowed tenant.
EAROS_SMOKE_AUTH_TOKEN=replace-with-non-production-session-token
EAROS_SMOKE_ALLOWED_ORGANIZATION_ID=replace-with-allowed-tenant-id
EAROS_SMOKE_CROSS_TENANT_CANDIDATE_ID=replace-with-candidate-id-from-a-different-tenant

# Required only by Docker Compose because its api service reads backend/.env.
# Store the actual deployment values in the secret manager or the local untracked backend/.env file.
# AUTH_SESSION_DATA_URL=https://approved-staging-identity.example/session
# MONGO_URL=mongodb+srv://...
# DB_NAME=earos_staging
# CORS_ORIGINS=https://staging.replace-with-your-domain.example
# EAROS_SESSION_SECRET=...
